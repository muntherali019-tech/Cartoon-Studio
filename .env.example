# Copy to .env for local development:  cp .env.example .env

# --- AI (Anthropic) ---
# Your Anthropic API key. Get one at https://console.anthropic.com
# If left blank, Cartoon Studio runs in a built-in DEMO mode with realistic,
# topic-aware sample content (no real AI calls, still fully clickable).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
# Optional: a separate model for vision (Toonify). Defaults to AI_MODEL.
AI_VISION_MODEL=
# Sampling temperature for creative writing (0–1) and structured JSON (0–1).
AI_TEMPERATURE=0.85
AI_JSON_TEMPERATURE=0.4

# --- Server ---
PORT=3000
# Storage: set DATABASE_URL to use Postgres (durable, multi-instance).
# Leave blank to use a local JSON file at DATA_DIR (fine for local/demo).
DATABASE_URL=
PGSSL=
DATA_DIR=./.data
# Secret used to sign login tokens. REQUIRED in production — long random value.
AUTH_SECRET=
# Set to 1 to disable the free-tier watermark everywhere.
CARTOON_NO_WATERMARK=

# --- Photoreal / illustration image generation (optional) ---
# When set, cartoons and toonify render through a real image model; otherwise
# the built-in client-side Toon Render engine draws them.
# Option A: OpenAI Images API
IMAGE_PROVIDER=            # set to "openai" to enable
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
# Option B: any custom endpoint taking {prompt,width,height} -> {url} or {b64}
IMAGE_API_URL=
IMAGE_API_KEY=

# --- Billing (Stripe, optional) ---
STRIPE_SECRET_KEY=
# Recurring subscription prices:
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
# One-time credit packs (à-la-carte revenue). Create one-time Prices for each.
STRIPE_PRICE_PACK60=
STRIPE_PRICE_PACK250=
STRIPE_PRICE_PACK600=
# From `stripe listen` (local) or the webhook endpoint settings (prod).
STRIPE_WEBHOOK_SECRET=

# --- Growth ---
# Credits granted to BOTH sides when a referral converts (default 15).
REFERRAL_BONUS=15

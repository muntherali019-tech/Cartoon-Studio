# Copy this file to `.env` and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-4-8   # default; use claude-sonnet-5 for lower cost
# PORT=8787
# RATE_LIMIT_PER_MIN=20             # per-IP cap on /api/generate (default 20)
